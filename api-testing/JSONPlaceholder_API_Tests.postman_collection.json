{
  "info": {
    "name": "JSONPlaceholder API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Educational example. POST/DELETE are simulated by JSONPlaceholder; writes do not persist. Updated with Codex. No SLA assertions."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"List has ten users\", () => { pm.expect(pm.response.json()).to.be.an(\"array\").with.lengthOf(10); });",
              "pm.test(\"Every user has id and email\", () => { pm.response.json().forEach(u => { pm.expect(u.id).to.be.a(\"number\"); pm.expect(u.email).to.be.a(\"string\"); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get user 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Returned id is 2\", () => { pm.expect(pm.response.json().id).to.eql(2); });",
              "pm.test(\"Email exists\", () => { pm.expect(pm.response.json().email).to.be.a(\"string\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "2"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Unknown user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"JSON content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Body is empty object\", () => { pm.expect(pm.response.json()).to.deep.equal({}); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "999"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create user simulated",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Created response has id\", () => { pm.expect(pm.response.json().id).to.be.a(\"number\"); });",
              "pm.test(\"Submitted data echoed\", () => { const body=pm.response.json(); pm.expect(body.name).to.eql(\"QA Example\"); pm.expect(body.email).to.eql(\"qa@example.com\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"QA Example\", \"email\": \"qa@example.com\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Delete user simulated",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Body is empty object\", () => { pm.expect(pm.response.json()).to.deep.equal({}); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "1"
          ]
        }
      },
      "response": []
    }
  ]
}
